/** 中文名 → T 编号（页面渲染时唯一对齐键，禁止按数组顺序猜测） */
export function therapistIdByCnName(cnName: string): string | undefined {
  return THERAPIST_META.find((m) => m.cnName === cnName)?.therapistId;
}
