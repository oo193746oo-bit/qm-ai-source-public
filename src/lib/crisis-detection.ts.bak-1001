};

// ========== RC1: 危机呈现分级（判定阈值/拦截零改动，仅呈现分级） ==========

// 低危（low）判据：纯情绪低落/疲惫/压力表达，无即时危险意图，不触发完整热线卡。
// 只用于"是否走轻提示模板"的呈现分级，不改变 detectCrisis 的 isCrisis/level 判定（防漏拦优先）。
// 高风险信号（自杀/自伤/轻生/结束生命/被动死亡意念等）一律走 high 完整卡，宁高勿低。
export const LOW_MOOD_SIGNALS = [
  "日子灰灰",
  "灰灰的",
  "最近好累",
  "好累",
  "压力大",
  "压力好大",
  "睡不着",
  "睡不好",
  "失眠",
  "心情down",
  "心情低落",
  "情绪低落",
  "提不起劲",
  "有点down",
  "心里堵",
  "心里空落落",
  "没什么精神",
  "有点撑不住的感觉",
  "最近特别累",
  "焦虑得很",
  "有点难过",
  "不太开心",
  "最近有点闷",
];

// 高危机意图信号（间接级内用于把"存活语境被动意念"拉回 high，宁高勿低）
const HIGH_INTENT_SIGNALS =
  /不想活|想死|自杀|自伤|自残|轻生|结束生命|了结|跳楼|跳河|割腕|烧炭|上吊|安眠药|活不下去|撑不住|撑不下去|想不开|活着?没(?:什么)?意思|活着?好累|没(?:什么)?盼头|没(?:什么)?意义|不想过|做傻事|伤害自己|离开这个世界|永远没|解脱|消失|睡过去(?:不用|不再|不再需要)?醒|我是(?:个|家里(?:的)?)?负担|走之前.{0,10}(?:安排|交代|处理)(?:好|完)|没有我(?:们)?他们?(?:更轻松|就轻松)/;

// RC1-R2 修点5：低危误伤收窄（RC1-R1 增量）
// R1 中"累/疲惫"类词可单独触发 low，导致「今天上班好累，想早点休息」这类日常组合被卷入低危、整段替换为固定轻提示。
// 修正（安全边界：只收窄明确日常语境，拿不准一律仍判 low，不放宽任何真危机模式）：
//   1. "累/疲惫"不再单独构成负面特征——须与明确情绪词（低落/灰/撑不住/绷不住/压力/绝望）共现；
//   2. 命中日常场景词（上班/工作/加班/忙/放假/周末/休息）且不含其他情绪/危机词时，不判 low。
// 纯"累/疲惫"但无场景词、也无高危机意图 → 仍判 low（宁高勿低）。
const DAILY_SCENE_SIGNALS = /上班|工作|加班|忙|放假|周末|休息|下班|开会|出差/;
const DAILY_RELIEF_WORDS = /累|疲惫|疲乏|困|乏/;
const EMOTION_WORDS = /低落|灰|撑不住|绷不住|压力|绝望|难过|不开心|烦|down|崩溃|想哭|委屈|堵/;

export function detectLowSeverityCrisis(text: string): boolean {
  const lowerText = text.toLowerCase();
  const hasHighIntent = HIGH_INTENT_SIGNALS.test(lowerText);
  if (hasHighIntent) return false;
  // 日常场景豁免：命中 累/疲惫 且 有日常场景词 且 无明确情绪词 → 不判 low（答非所问）
  if (DAILY_RELIEF_WORDS.test(lowerText) && DAILY_SCENE_SIGNALS.test(lowerText) && !EMOTION_WORDS.test(lowerText)) {
    return false;
  }
  const hasLowMood = LOW_MOOD_SIGNALS.some((w) => lowerText.includes(w.toLowerCase()));
  if (!hasLowMood) return false;
  return true;
}

// RC1 低危轻提示模板：共情承接 + 一句轻提示 + 对话自然继续。不弹完整四行卡、不追问安全评估。
export const CRISIS_LOW_RESPONSE = `听你说这些，能感觉到你最近挺不容易的。状态有些低落、没什么力气，是很常见的，你不需要把它们都扛在自己肩上。

如果想说说话，小酷一直都在；想找专业的人聊聊，QM 24 小时支持热线 15001930070 也随时为你在。你愿意的话，可以和我多说说最近发生了什么吗？`;

export const LOW_CRISIS_LEVEL = "low";

// 补丁一：危机模板"我记得你"上下文插槽
// 从最近 history（user 原文）抽取身份/事件类自我暴露原话短语，合成前置"记得你"段落。
// 只引用原话短语、禁改写；命中最多 2 条；命中 0 条返回空串（不虚构，也不加"我记得你"占位）。
const REMEMBER_IDENTITY_KEYWORDS = ["跨性别", "变性", "txl", "同性", "出柜", "激素", "喉结", "胡子", "身份证", "证件", "MTF", "FTM"];
const REMEMBER_EVENT_KEYWORDS = ["相亲", "爸妈", "爸", "妈", "家里", "工作", "学校", "宿舍", "分手", "喜欢的人", "吵架", "身体", "镜子", "割腕", "伤口"];

function extractQuoteFragment(text: string, kw: string): string {
  const idx = text.indexOf(kw);
  if (idx < 0) return kw;
  let start = idx;
  while (start > 0 && !/[\n。！？，、；：]/.test(text[start - 1]) && idx - start < 12) start--;
  let end = idx + kw.length;
  while (end < text.length && !/[\n。！？，、；：]/.test(text[end]) && end - start < 20) end++;
  const q = text.slice(start, end).trim();
  return q.length >= kw.length ? q : kw;
}

export function buildRememberYouBlock(historyUserTexts: string[]): string {
  const ordered = [...historyUserTexts].reverse();
  const chosen: { kind: "identity" | "event"; quote: string }[] = [];
  for (const text of ordered) {
    if (chosen.length >= 2) break;
    for (const kind of ["identity", "event"] as const) {
      const kws = kind === "identity" ? REMEMBER_IDENTITY_KEYWORDS : REMEMBER_EVENT_KEYWORDS;
      const hit = kws.find((k) => text.includes(k));
      if (hit && !chosen.some((c) => c.kind === kind)) {
        chosen.push({ kind, quote: extractQuoteFragment(text, hit) });
        break;
      }
    }
  }
  if (chosen.length === 0) return "";
  const parts = chosen.map((c) =>
    c.kind === "identity"
      ? `你之前跟我说过${c.quote}，这件事我一直记着，此刻它也在我心里。`
      : `还有${c.quote}这件事压着你，我知道你不是无缘无故走到这一步的。`,
  );
  return `${parts.join("\n")}\n\n`;
}


// ========== 批F：危机回撤机制（误触澄清后的撤卡轻回；触发从严：上一轮危机+本轮零命中+明确澄清词） ==========
export const CRISIS_WITHDRAW_ACK = `刚才是有点担心你——现在听你说没有那种情况，我就放心了。\n\n要是之后想聊什么，或者哪天情绪又沉下去，随时回来找我，小酷在这里。`;

const CRISIS_WITHDRAW_TRIGGERS = ["不是", "没有", "没有啦", "开玩笑", "逗你", "假的", "随便说说", "随口", "别担心", "没事", "不需要", "不用担心", "放心", "还好", "没在想", "不会真的", "不打了", "不想了"];

export function detectCrisisWithdraw(userText: string, prevAssistantText: string): boolean {
  if (!userText || !prevAssistantText) return false;
  const prevCrisis = /你现在人安全吗|12356|15001930070|紧急危险请拨/.test(prevAssistantText);
  if (!prevCrisis) return false;
  const head = userText.trim().slice(0, 12);
  if (!head) return false;
  return CRISIS_WITHDRAW_TRIGGERS.some((w) => head.includes(w));
}

// ========== T1（20260924，Lumen E3）：低危模糊档——先共情接住+末尾轻留一个热线，不弹完整危机卡 ==========
// 背景：低危模糊表达（状态很不好/很累/撑不住/心情差/难受等无明确自伤他伤信号的负向表达）在模型中
// 会被秒切完整危机卡，吓到用户也稀释真的危机严肃性。T1 把这类模糊低落档从完整卡降级为轻留档。
// 安全不变量：本判据只在 detectCrisis 返回 isCrisis=false（已排除 direct/indirect/gentle 全部明确信号）
// 之后才被调用；任何明确危机信号词（自杀/自残/轻生/不想活/想死/想消失等）在 detectCrisis 已归完整卡，
// 绝不落到本档。这里追加一层极端信号守卫作第二道保险（防词表演进时裸词绕过）。
const T1_HIGH_GUARD =
  /自杀|自残|自伤|轻生|不想活|想死|结束了?生命|了结|跳楼|跳河|割腕|烧炭|上吊|安眠药|活不下去|伤害自己|离开这个世界|想消失|解脱|做傻事|划自己|割自己|跳下去/;

const T1_STATE_BAD = /(?:状态|情绪|心情|整个人)(?:一直|最近|这两天)?(?:很|特别|非常|太过|真|真的|无比|有点)?(?:不好|差|糟糕|很差|糟透|很低|沉重|down)/;
// 累类偏重日常场景豁免参考 RC1：纯"上班好累想休息"不卷入低危
const T1_TIRED = /(?:最近|这两天|这段时间|这几天|这些天|今天)?(?:好累|很累|特别累|太累|累得|累到|每天都累|累极了)/;
const T1_DAILY_SCENE = /上班|工作|加班|忙|放假|周末|休息|下班|开会|出差|通勤|地铁|公交|堵车|上学|上课|作业|考试|老板|甲方|deadline|打卡/;
const T1_TIRED_EMOTION = /低落|灰|撑不住|绷不住|压力|绝望|难过|不开心|烦|崩溃|想哭|委屈|堵|难受|状态差|心情差|煎熬/;
const T1_EXHAUSTED = /(?:撑不住|撑不太住|有点撑不住|快撑不住|撑不过去|扛不住|顶不住)/;
const T1_BAD_MOOD = /(?:心情|心里)(?:特别|真的|很)?(?:差|不好|难受|堵|down|低落|灰灰|沉重)|(?:很难受|心里难受|不太舒服|不开心|开心不起来|没力气|提不起劲|提不起精神|没什么精神|烦透了|好压抑|太压抑|喘不过气|缓不过来)/;

export function detectT1LowMood(text: string): boolean {
  const t = text.toLowerCase();
  if (T1_HIGH_GUARD.test(t)) return false;
  if (T1_STATE_BAD.test(t) || T1_EXHAUSTED.test(t) || T1_BAD_MOOD.test(t)) return true;
  // "累"类：命中日常场景且无额外情绪词 → 视为日常表述，不卷入低危模板
  if (T1_TIRED.test(t) && T1_DAILY_SCENE.test(t) && !T1_TIRED_EMOTION.test(t)) return false;
  if (T1_TIRED.test(t)) return true;
  return false;
}

// ========== P5（20260925，第5棒）：他人风险主体判定——他人且无具体即时危险 → 降级承接 ==========
// 背景：风险主体是他人（朋友/家人/ta）、用户自身无风险信号时，会误触发完整危机卡，不承接用户自己的
// 疲惫与边界困境。本函数识别"他人风险 + 无具体即时危险信号"档，命中则该警示由 route 降级为
// "承接用户自身 + 支持策略 + 末尾轻留一个热线"，不弹完整危机卡。
// 安全不变量：仅针对 matchedWords 命中 third_party_helper_crisis 的路径降级——
//   ① 该分支在 detectCrisis 内已要求 !thirdPartySelf（本人自陈不进入该分支），本人信号不会被误降；
//   ② 具体即时危险硬词（跳楼/跳下去/割腕流血等）命中的是其他 matched，不在本档，即时危险不降级；
//   ③ 双主体（ta + 本人）本人信号 priority 已走本人完整卡，不进入本档。
// 词表零增删：仅新增分流函数与文案，不动 direct/indirect/gentle 词条。
export function isOtherRiskWithoutUrgency(crisisResult: { matchedWords?: string[] }): boolean {
  return (crisisResult.matchedWords || []).some((w) => w === "third_party_helper_crisis");
}

// P5：他人场景"具体即时明确危险"判定——只认明确的即时手段/位置/正在实施表达，宽松危机词（想不开/告别/撑不住）不算。
// 用于他人风险降级：即时危险升级完整危机卡，无即时危险则承接用户自身+支持策略+轻留。宁严勿纵（宽松词不误升）。
export function hasImmediateDangerSignal(text: string): boolean {
  const t = text;
  // 1) 即时性 + 高致命手段（正在/现在/马上/刚刚 + 跳/割/吞/挂/站/蹲/爬/喝/吃/动手/实施/来/走）
  if (/(?:正在|现在|马上|立刻|刚刚|刚才).{0,6}(?:跳|割|吞|挂|站|蹲|爬|喝|吃|动手|实施|来|走)/.test(t)) return true;
  // 2) 高致命行为/身体伤害（跳楼/割腕/自残/流血/上吊/吞药/绑绳——保留 P5 覆盖）
  if (/(?:跳|纵身|往下|一头).{0,4}(?:楼|桥|河|崖|下去)|割腕|割手腕|划手腕|割脉|割动脉|服药过量|过量服药|自残|流血|止不住血|上吊|跳下去|吞(?:了|下|下去).{0,4}(?:药|安眠药)|吞.{0,3}整瓶|吃.{0,3}整瓶|脖子挂着|绑好.{0,3}(?:绳|带)/.test(t)) return true;  // R34: 割手腕/服药过量词形族补全
  // 3) 凶器/利器架身（P56①：刀/利器 + 架/抵/贴/顶 + 脖子/身上等 即时接触组合）
  if (/(?:刀|匕首|剪刀|利器|美工刀|水果刀|剃刀|玻璃(?:片|渣|块)|刃|尖(?:物|器))(?:.{0,5})?(?:架|抵|顶|贴着?|戳|对着?|压|搁|比着?)(?:.{0,5})?(?:脖子|喉咙|喉|胸口|胸前|手腕|动脉|身上|自己)/.test(t)) return true;
  if (/刀.{0,6}(?:架|抵|顶|贴着?|对着?|戳).{0,6}脖子|脖子上.{0,5}(?:架|抵|顶|贴|按|比着?)/.test(t)) return true;
  // 3c) 裸三字「刀架脖」（R3.1 20260929 词面补全：P58 口径 direct，与 3a/3b 同族）
  if (/刀架脖/.test(t)) return true;
  // 4) 遗书/告别信 + 明确时间/地点/倒计时（P56②）
  if (/(?:遗书|告别信|绝笔信?|遗言)(?:.{0,18})(?:今晚|今天|明天|凌晨|深夜|几点|几点钟|半小时|倒计时|还剩|还有|没多少|天台|楼顶|顶楼|窗台|河边|桥上|学校|宿舍|放学|出门|跳|结束|实施|不在了|走)/.test(t)) return true;
  // 5) 高位 + 高致命意图（站在/蹲在/爬上 天台/楼顶/桥/阳台）
  if (/站在.{0,4}(?:天台|楼顶|窗台|桥(?:上|边)|阳台)|蹲在.{0,4}(?:天台|楼顶|窗台|桥|阳台)|爬上.{0,4}(?:天台|楼顶|窗台|栏杆)/.test(t)) return true;
  // 5b) 进行中：正(在)处高危位置伴下跳/纵身意图
  if (/(?:正在|正).{0,5}(?:天台|楼顶|顶楼|窗台|桥(?:上|边)?|阳台|栏杆|边缘).{0,5}(?:跳|往下|纵身|跨|迈|要跳)/.test(t)) return true;
  // 6) 取凶器/动手临近（扬起刀/正要/就要跳/已经割/伤口还在/抽出刀）
  if (/扬起.{0,4}(?:刀|利器)|正要|就要跳|已经割|伤口还在|抽(?:出|起)?.{0,2}(?:刀|匕首|利器)/.test(t)) return true;
  return false;
}

// 小酷版他人支持承接模板：先承接用户自身的累/边界困境 → 支持策略 → 末尾轻留一个热线。
// 禁完整卡四特征（12356/15001930070/13601658763/☎ 多号并排），末尾仅留一个号码。
export const CRISIS_OTHER_SUPPORT_RESPONSE = `听你说这些，也能感觉到你其实很累，也很为难——一边是自己的疲惫、不想再越过边界的难受，一边又怕 TA 出什么事，舍不得也放不下这份担心。你把这些扛在心里，很不容易。

如果你愿意，可以和小酷多说说你现在的处境：是哪些事让你不敢拒绝，你最担心的是哪一部分？我们也可以一起看看，怎么在保护自己的前提下，也给到对方关心——比如陪着 TA 说说话、帮 TA 联系信任的专业支持，或者陪 TA 一起去看看医生，这些都未必需要你一个人扛。

如果需要专业帮助，QM 也有 24 小时支持热线 15001930070，随时可以打。`;
