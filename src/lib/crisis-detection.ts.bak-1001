// 未成年人识别关键词
export const MINOR_KEYWORDS = [
  "初二", "初三", "高一", "高二", "高三", "六年级", "初一",
  "初中", "高中", "小学", "中学生", "小学生",
  "爸妈", "妈妈", "爸爸", "家长", "老师", "同学",
  "学校", "作业", "考试", "上课",
  "未成年", "青少年", "18岁以下",
  "不能让我妈知道", "不能让我爸知道", "偷拿手机",
];

export function detectMinor(text: string): boolean {
  const lowerText = text.toLowerCase();
  return MINOR_KEYWORDS.some((keyword) => lowerText.includes(keyword));
}

// ========== 1.9.1: 危机检测词表扩展（隐喻式、负担感式、计划式、告别式、断续式） ==========

// 第一人称"自我消失/不在"语义族
const SELF_ABSENCE = /没有我|我不在(了)?|我走了|我消失|我没了|我离开(了)?|从世界上消失/i;
// "他人因此变好/解脱"语义族
const OTHERS_RELIEF = /轻松|解脱|过得更好|会更好|少点?麻烦|不(再)?拖累|不为难|松口气|好过|省心/i;
// 独立的消失愿望族（不依赖共现）
const VANISH_WISH = /如果我消失|我想消失|人间蒸发|从这个世界上消失|我不存在了|对话框会记得我吗|你们会记得我吗/i;

// 1.9.1 新增：隐喻式（结束键、睡过去、飘走、天上的云等）
const METAPHOR_WISH = /结束键|按个结束|结束人生|睡过去|永远睡|飘走|天上的云|消失在|一了百了/i;

// 1.9.1 新增：负担感式（正则共现）
const BURDEN_PATTERN_1 = /没有我.{0,12}(好过|轻松|解脱|省心)/i;
const BURDEN_PATTERN_2 = /(我|自己).{0,6}(多余|累赘|没用|留着没用|走了就好)/i;
const BURDEN_PATTERN_3 = /(他们|大家|家里).{0,12}(没有我|少了我).{0,12}(好|轻松|解脱)/i;
// R34（20260930）：BURDEN_PATTERN_2 的「没用」分支收窄——「钥匙对我没用」类工具/宾语语境误伤修复。
// 只收窄「(我|自己).{0,6}没用」子模式；「多余/累赘/留着没用/走了就好」分支保持原样零变化。
// 语境词含自述形（好没用/真没用/太没用/没用的人）与生存语境（活着/生活/人生/这个世界/废物/做人）。
const BURDEN_2_USELESS = /(我|自己).{0,6}没用/i;
const BURDEN_CONTEXT_2 = /活着|生活|人生|这个世界|世界上|没用的人|废物|做人|活在|好没用|真没用|太没用|这么没用/;
function burden2WithContext(text: string): boolean {
  if (!BURDEN_PATTERN_2.test(text)) return false;
  if (!BURDEN_2_USELESS.test(text)) return true;  // 非「没用」词命中（多余/累赘/走了就好等）→ 原样判危机
  const sentences = text.split(/[。！？；\n!?;]+/);
  return sentences.some((s) => BURDEN_2_USELESS.test(s) && BURDEN_CONTEXT_2.test(s));
}

// 1.9.1 新增：计划/预备式
const PLAN_PATTERN = /想好.{0,10}(怎么|如何).{0,10}(走|离开|结束)|攒了.{0,6}(药|安眠药)|不会痛的|悄悄走|最后一次.{0,8}(说|聊|见)/i;

// 1.9.1 新增：告别式
const FAREWELL_PATTERN = /最后一次跟?(人|你|大家).{0,6}(说|聊)|谢谢你陪我.{0,20}最后/i;

// 1.9.1 新增：断续犹豫式（碎片共现）
const HESITATION_FRAGMENT_1 = /算了|不说了/i;
const HESITATION_FRAGMENT_2 = /没用|没意义|熬不下去|撑不住|不想熬/i;

// 专业/第三人称视角闸门（1.9.1 扩展：增加法律学术词）
// 1.9b P0-2: 视角闸门扩面（创作/公共卫生/专业元语境）
// [P06-P07-FIX 20260915] 检测词表（Lara 2026-09-15 拍板 A 方案，仅新增前置闸，不动既有危机路径）
const PAST_HISTORY_DEATH_KEYWORDS = /自杀|轻生|想死|不想活|活不下去|自伤|自残|割腕|跳楼|跳河|结束生命|了结|一了百了/;
const PAST_HISTORY_TIME_MARKER = /(?:[0-9０-９一二两三四五六七八九十百千]+|些|好些)\s*年\s*前|以前|之前|上次|上回|当年|曾经|早些年/;
const CURRENT_TIME_MARKER = /现在|如今|最近|这(?:段|几|阵|些)(?:时间|日子|年)?|眼下|目前/;
const CURRENT_STABLE_MARKER = /还行|还好|过得去|稳定|挺好|挺稳|不错|好多了|好起来|好转|平静|安顿|踏实/;
// 近期危险守卫：命中则不降级（昨天/今天类近况或"又割/又吞"仍走原危机路径）
const RECENT_EVENT_GUARD = /昨天|昨晚|昨夜|刚才|刚刚|今天|今晚|今早|前天|这几天|上周|上礼拜|上个月|最近一次|又(?:割|划|吞|跳)/;
// P07 习语豁免表：X死/加到想死 等口语习语
const IDIOM_DEATH_PATTERN = /笑死|累死|无聊死|饿死|困死|热死|冷死|烦死|愁死|吓死|挤死|忙死|渴死|撑死|加到想死|累到想死|忙到想死|困到想死|烦到想死|愁到想死/;
const IDIOM_DAILY_CONTEXT = /加班|上班|上学|上课|作业|考试|复习|工作|项目|需求|开会|值班|通勤|地铁|公交|堵车|排队|天气|老板|甲方|期末|周报|deadline|打卡/i;

const PROFESSIONAL_CONTEXT = /量表|评估|量化|研究|文献|理论|概念|perceived burdensomeness|INQ|问卷|测量|论文|学术|教学|培训|督导|案例讨论|法条|法规|制度|法律|四类主体|生效条件|认定民事|写小说|小说里|角色|编剧|剧组|拍戏|拍一段|剧本|创作|怎么写这段|台词|自杀率|预防体系|干预体系|学校层面|公共卫生|数据统计|流行病学|接听流程|拍摄|避免拍错|误导观众|问法|访谈|记录|筛查|保密例外/i;

/**
 * 1.9.1: 扩展负担感/消失愿望信号确定性检测
 * 同一句话输入10次结果必须10次一致
 */
function detectBurdenSignal(text: string): boolean {
  if (PROFESSIONAL_CONTEXT.test(text)) return false;  // 视角闸门优先，专业讨论不亮灯
  if (VANISH_WISH.test(text)) return true;
  if (METAPHOR_WISH.test(text)) return true;  // 1.9.1 新增：隐喻式
  if (PLAN_PATTERN.test(text)) return true;   // 1.9.1 新增：计划式
  if (FAREWELL_PATTERN.test(text)) return true; // 1.9.1 新增：告别式
  // 1.9.1 新增：断续犹豫式（碎片共现）
  if (HESITATION_FRAGMENT_1.test(text) && HESITATION_FRAGMENT_2.test(text)) return true;
  // 1.9.1 新增：负担感式（三种模式任一命中）
  if (BURDEN_PATTERN_1.test(text) || burden2WithContext(text) || BURDEN_PATTERN_3.test(text)) return true;  // R34: 没用分支加语境约束
  return SELF_ABSENCE.test(text) && OTHERS_RELIEF.test(text);
}

// CRFIX2（20260925）：本人后事类多信号规则——自述「我在安排/交代/处理/分配自己的身后事」= 明确的自我终结准备信号 → 置危机 direct。
// 与 5.7b 告别信（他人遗书类）是两类问题，勿混：本条只认「后事/身后事+自我指向+安排动作」。
// 防误伤设计：①以「后事/身后事」为必含核词（无后事词一律不亮，还清房贷/怕ta想不开/情绪低落不命中）；
// ②要求自我指向（我/自己/本人）与安排动作（安排/交代/处理/分/办/写/就等）在句中成对出现，纯咨询/疑问句式不命中；
// ③排除帮助/他人/旁观语境（帮忙处理后事、家人/姥姥/他/她的后事、办理咨询）——三者任一命中即否决。
function hasPersonalAfterlifeSignal(text: string): boolean {
  if (!/后事|身后事/.test(text)) return false;
  // 三方向交替：①后事在先动作在后（我把后事安排好）②后事+我（后事我都安排好了）③动作在先后事在后（我交代身后事）
  const selfAfterlife =
    /我(?:自己|本人)?(?:.{0,14})(?:后事|身后事)(?:.{0,10})(?:安排|交代|处理|分(?:好|配)?|办(?:好|妥)?|写(?:好|了)?|给(?:了|好)?|准备好|就等)|(?:后事|身后事)(?:.{0,10})(?:我|自己)(?:.{0,16})(?:安排|交代|处理|分(?:好|配)?|办(?:好|妥)?|写好|准备好|就等)|我(?:自己|本人)?(?:.{0,8})(?:安排|交代|处理)(?:.{0,4})(?:后事|身后事)/;
  if (!selfAfterlife.test(text)) return false;
  const neutralOrOthersContext = /怎么办|如何办|咨询|请教|请问|怎么处理|怎么办理|流程|手续|费用|了解一下|了解下|问问|想问|帮忙|帮他|帮他家|帮(?:着|忙)?(?:我)?(?:家人|父母|亲戚|姥姥|奶奶|爷爷|外公|舅舅)|我(?:的)?(?:家人|父母|亲戚|姥姥|奶奶|爷爷|外公).{0,8}(?:后事|身后事)|他(?:的|家|们)|她的|别人(?:的)?/;
  return !neutralOrOthersContext.test(text);
}

export function detectCrisis(text: string): {
  isCrisis: boolean;
  level: "direct" | "indirect" | "gentle" | "none";
  matchedWords: string[];
} {
  // R3（20260929 按P0-0923工单口径）：direct层误伤豁免 词表本体零改动
  const R3_SELF_HARM = /死|自杀|自残|自伤|轻生|不想活|不活了|活不下去|了结|遗书|安眠药|割腕|上吊|烧炭|跳|这个世界|人间|结束生命|不在了|消失|走掉|动手|实施|撑不住|撑不下去/i;
  const R3_WALK_DAILY = /走(?:了|过|着|到|去)?(?:[0-9０-９两三四五六七八九十百千万几]+|很多|无数)(?:多)?(?:步|里|公里|米)|走了.{0,6}?(?:路|步|里|公里)/;
  const R3_WITHDRAWAL = /气话|吓到|缓过来|缓过劲|没事了|开玩笑|玩笑话|不想聊这个了/i;
  if (!R3_SELF_HARM.test(text) && (R3_WALK_DAILY.test(text) || R3_WITHDRAWAL.test(text))) {
    return { isCrisis: false, level: "none", matchedWords: ["r3_fp_exempt"] };
  }
  const lowerText = text.toLowerCase();

  // 第1层：确定性硬闸（独立配置，无条件覆盖——在专业豁免/玩笑豁免之前，命中即 direct 不许下钻）
  const hardGate = detectHardGate(text);
  if (hardGate.gate) {
    return { isCrisis: true, level: "direct", matchedWords: hardGate.matched ? [hardGate.matched] : ["hardgate"] };
  }

  // T10 新闻/社会旁观前置豁免（与 hardGate 同款守卫，防第2层 keyword 绕过）：
  // 主语为"新闻/报道/有人/别人/大家"等旁观视角，且全文无第一人称危险意图 → 正常讨论，不置危机。
  // 一旦出现"我也/换我/如果是我就…"等第一人称危险意图，仍升级硬卡（见 hardgate L61 规则）。
  // [P06-P07-FIX 20260915] 前置闸：位于硬闸之后、既有判定之前，仅新增不改旧路径
  // P06：第一人称过去史（死亡类关键词+过去时间状语）且当下稳定（现在类时间词+稳定状态词）→ 温和资源卡
  if (
    PAST_HISTORY_DEATH_KEYWORDS.test(text) &&
    PAST_HISTORY_TIME_MARKER.test(text) &&
    CURRENT_TIME_MARKER.test(text) &&
    CURRENT_STABLE_MARKER.test(text) &&
    !RECENT_EVENT_GUARD.test(text)
  ) {
    return { isCrisis: true, level: "gentle", matchedWords: ["past_history_gentle"] };
  }

  // P07：口语习语（X死/加到想死 等）+ 日常语境词同时命中 → 豁免，不打危机卡（保留正常情绪承接）
  if (IDIOM_DEATH_PATTERN.test(text) && IDIOM_DAILY_CONTEXT.test(text)) {
    return { isCrisis: false, level: "none", matchedWords: [] };
  }

  const bystander = /(?:新闻|报道|资讯|热搜|消息说|听(?:说|到)|看到|大家|有人|有个人|他们|那些人|别人|路人|网(?:友|上))/i;
  const firstPersonDangerIntent = /(?:我也|换我|我也会|我可能|我想.{0,4}(?:也|就)|我要(?:那)?样|如果是(?:我|我自己)|假设我)/i;
  const bystanderExempt = bystander.test(text) && !firstPersonDangerIntent.test(text);

  // P18-1: 负担感/消失愿望确定性检测（视角闸门内置）
  if (detectBurdenSignal(text)) {
    return { isCrisis: true, level: "direct", matchedWords: ["burden_or_vanish_signal"] };
  }
  
  // T10 新闻旁观前置豁免（与 hardgate 同款守卫）：旁观视角且无第一人称危险意图 → 正常讨论
  if (bystanderExempt) {
    return { isCrisis: false, level: "none", matchedWords: [] };
  }

  // CRFIX2（20260925）：本人后事类多信号 → 置危机 direct（与本人危机同层）。仅新增路径，不改既有判定。
  if (hasPersonalAfterlifeSignal(text)) {
    return { isCrisis: true, level: "direct", matchedWords: ["personal_afterlife_signal"] };
  }
  
  // P05（安全侧定稿）：第一人称 + 撑不住/好痛苦 → 硬卡，宁严勿漏（工单明确"永久保留硬卡"）。
  // 仅限第一人称自陈（含"我/自己/本人/真的"等），排除专业讨论与玩笑豁免可覆盖的对象化表述。
  const painDirect = /(?:我|自己|本人|真的|越来越|实在|全都|这些年).{0,8}(?:撑不住|撑不下去了|撑不住(?:了)?|熬不住|熬不下去|受够了|受不下去了|抗不住|撑不下去).{0,10}(?:好痛苦|太痛苦|很痛苦|难受|痛|疼|煎熬|熬|没力气|撑|绝望)/;
  const painShort = /(?:我|自己|本人).{0,6}(?:好痛苦|太痛苦|非常痛苦|真的受够了|实在撑不住|快撑不住了|撑不住(?:了)?)/;
  if ((painDirect.test(text) || painShort.test(text)) && !PROFESSIONAL_CONTEXT.test(text)) {
    return { isCrisis: true, level: "direct", matchedWords: ["first_person_pain_direct"] };
  }
  
  // P17-2: 专业讨论视角闸门——整个危机检测都过闸门
  if (PROFESSIONAL_CONTEXT.test(text)) {
    return { isCrisis: false, level: "none", matchedWords: [] };
  }
  
  // P1.8 H8：玩笑/吐槽信号消歧
  // 同句含明确玩笑/吐槽信号且无第一人称具体计划/手段/时间 → 降级为共情陪聊
  const jokeSignals = /哈哈哈|笑死|社死|原地去世|老板|上班|周五|加班|吐槽|23333|6666|233|666/i;
  const explicitPlanSignals = /计划|准备|已经.*决定|今晚|明天|具体.*方法|写了.*遗书|站在.*楼顶|割腕|跳楼|跳河|安眠药|买.*药|药.*准备好了|收集.*药|囤.*药|掌握.*方法/i;
  if (jokeSignals.test(text) && !explicitPlanSignals.test(text)) {
    // 玩笑/吐槽语境，无明确计划，不触发危机模板
    return { isCrisis: false, level: "none", matchedWords: [] };
  }
  
  // P1.8 H8 缺口3：被动意念句检测（活着没意思/没人会在意我/想干脆消失）
  // 固定动作：共情+温和安全确认问句+轻量资源兜底（含热线卡）
  const sleep = /睡过去(?:不用|不再|不再需要)?醒|不想醒|想睡过去|睡一觉.{0,6}(?:不用|不要再|不想)?醒|醒不过来/;
  const burden = /我是(?:个|家里(?:的)?)?负担/;
  const prepareToGo = /走之前.{0,10}(?:安排|交代|处理)(?:好|完)/;
  const vanishRelief = /没有我(?:们)?他们?(?:更轻松|就轻松)/;
  // P0-1: 第一人称「否定醒转」之被动意念 + 高危行为佐证（窗边/天台/河边等持久停留）→ 漏报零容忍
  // 仅当两者同时命中才置危机：单有「不想醒」可能是起床口语，单有「窗边站」可能是发呆。
  const firstPersonPassiveSleep = /我(?:自己|本人)?.{0,10}(?:不想醒(?:过来|来)?|睡过去(?:就)?不醒|就这么睡过去|睡着(?:就|了)?不醒|醒不过来|再也不要醒)/;
  const highplaceStay = /(?:窗边|窗户边|窗台|天台|楼顶|阳台|河边|江边|水边|桥边|栏杆)(?:.{0,10}?)?(?:站|坐|待|蹲|趴|转|走)(?:了)?(?:很久)?/;
  if (firstPersonPassiveSleep.test(text) && highplaceStay.test(text) && !explicitPlanSignals.test(text) && !PROFESSIONAL_CONTEXT.test(text)) {
    return { isCrisis: true, level: "indirect", matchedWords: ["first_person_passive_ideation"] };
  }
  const passiveIdeationSignals = /活着.*没意思|活着.*没意义|活着.*有什么意思|活着.{0,8}有啥意思|找不到活着的意义|活着.*还有什么意义|生活.*没意义|没人在意|没有人.*在意|想.*消失|想.*离开|干脆.*消失|不如.*消失|存在.*没意义|(?:活着|生活|人生|日子|活下去|撑下去|活下去的日子).{0,14}(?:没意思|没意义|没什么意思|没什么意义|有什么意义|没有意义)|(?:活着|生活|日子|人生|活下去).{0,6}(?:没|无|看不到|没有).{0,6}(?:盼头|奔头)|看不到.{0,6}(?:生活|日子|人生|活着|未来).{0,6}(?:盼头|奔头|意义)|找不到.{0,4}(?:意义|价值|奔头|盼头)|(?:消失|不见了|离开这个世界|消失不见|凭空消失|就这样消失).{0,10}(?:就好|就轻松|就解脱|就算了|就省心|就没人烦|就是解脱)|(?:要是|如果|能就地|现在).{0,8}消失.{0,8}(?:就好|就解脱|就轻松|就算了|多好)|(?:要是|如果|能)。{0,10}(?:消失了?|不见了?|就这样消失).{0,10}(?:就?不|也不用|就不用|就不|也就)(?:累|难过|痛苦|烦恼)/i;
  const r2Patterns = sleep.test(text) || burden.test(text) || prepareToGo.test(text) || vanishRelief.test(text);
  if (r2Patterns && !explicitPlanSignals.test(text)) {
    return { isCrisis: true, level: "indirect", matchedWords: ["r45_passive_ideation_signal"] };
  }
  const R3_LEAVE_TERMINUS = /离开.{0,8}(?:这个世界|世界|人间|所有人|一切|尘世)/i;
  const R3_LEAVE_PLACE = /离开[\u4e00-\u9fa5]{0,3}?(?:岛|市|省|县|镇|村|国|洲)|离开(?:学校|公司|单位|工厂|医院|大学|中学|小学|这里|那个地方|这个地方)/i;
  if (passiveIdeationSignals.test(text) && !explicitPlanSignals.test(text) && !(R3_LEAVE_PLACE.test(text) && !R3_LEAVE_TERMINUS.test(text))) {
    // 被动意念句，无明确计划，触发间接危机（轻量资源兜底）
    return { isCrisis: true, level: "indirect", matchedWords: ["passive_ideation_signal"] };
  }
  
  // 原有精确匹配逻辑
  // P1.11：第三人称帮助者危机（学生/来访者/亲友/同事…代为求助，含他/她等隐式第三主体）
  // 兜底同学/来访者等帮助者场景：即使未命中第一人称自陈词，也认定为危机
  const thirdPartyRole = /我(?:的|们?的|身边|认识|担心|班上|带的|接待的|负责的)?(?:有(?:个|位)?)?(?:同学|室友|舍友|朋友|闺蜜|家人|孩子|儿子|女儿|对象|伴侣|老公|老婆|学生|学员|同事|网友|邻居|来访者|来访|当事人|服务对象|案主)|(?:班上有|班里|他的?|她的?|学生|同学|来访者|求助者|当事人|服务对象|案主)|(?:班主任|老师|辅导员)|(?:他|她|TA|ta|他们|她们)/;
  const thirdPartyCue = /告别|道别|说再见|对不起所有人|联系不上|遗书|自伤|自杀|轻生|想不开|不想活(?:了)?|不想过(?:了)?|做傻事|撑不住|撑不下去|活不下去|伤害自己|自残|划自己|有.{0,4}(?:自杀|轻生).{0,6}(?:风险|倾向|念头)|没了他(?:们)?怎么办/;
  const thirdPartySelf = /我.{0,6}(?:不想活|想死|想自杀|撑不住|撑不下去|活不下去|想不开)/;

  // C3：第三人称 NSSI + 明确否定死亡意图（"反复割腕，但他说他不想死"）→ NSSI ≠ 自杀企图，
  // 走专业装配（MED-03 纠正），不置危机卡。但陪伴者慌乱/此刻正在发生仍保危机（判定规则3）。
  // NSSI 行为词与死亡意图否定词距离相关，防误伤；否定死亡意图可无转折词（如"割腕不想死"）。
  const thirdPartyNssi = /(?:割腕|自伤|自残|划自己|伤害自己|拿(?:刀|利器|刀片)(?:割|划|切)?.{0,8})/;
  const nssiDenyDeathIntent = /(?:割腕|自伤|自残|划自己|伤害自己|拿(?:刀|利器|刀片)).{0,26}(?:不想死|没想死|没想过死|不是(?:想|要)死|不是自杀|没有自杀|不想自杀|只是需要释放|需要一种释放|只是为了释放|只为释放|不想离开世界)|(?:不想死|不是(?:想|要)死|不是自杀|没有自杀|不想自杀).{0,10}(?:只是|纯粹|就是).{0,10}(?:释放|发泄|解脱)/;
  const panickedNow = /怎么办|正在|现在|快来|紧急|马上|刚刚.{0,6}(?:割|划|拿刀)|送医|救命|流血|还在淌/;
  if (thirdPartyNssi.test(text) && nssiDenyDeathIntent.test(text) && !panickedNow.test(text) && !thirdPartySelf.test(text)) {
    return { isCrisis: false, level: "none", matchedWords: ["third_party_nssi_deny_death_intent"] };
  }

  if (thirdPartyRole.test(text) && thirdPartyCue.test(text) && !thirdPartySelf.test(text)) {
    return { isCrisis: true, level: "direct", matchedWords: ["third_party_helper_crisis"] };
  }

  // 检测中文关键词
  const directMatches = CRISIS_KEYWORDS.direct.filter((word) =>
    lowerText.includes(word.toLowerCase()),
  );
  const indirectMatches = CRISIS_KEYWORDS.indirect.filter((word) =>
    lowerText.includes(word.toLowerCase()),
  );
  
  // 检测英文关键词
  const enDirectMatches = ENGLISH_CRISIS_KEYWORDS.direct.filter((word) =>
    lowerText.includes(word.toLowerCase()),
  );
  const enIndirectMatches = ENGLISH_CRISIS_KEYWORDS.indirect.filter((word) =>
    lowerText.includes(word.toLowerCase()),
  );
  
  const allDirectMatches = [...directMatches, ...enDirectMatches];
  const allIndirectMatches = [...indirectMatches, ...enIndirectMatches];

  if (allDirectMatches.length > 0) {
    // A 修复（R34 20260930）：否定/假设语境豁免——direct 词命中但词前 6 字含否定/假设标记 → 降 gentle 温和资源卡。
    // 背景：3e58a9e 的 R3 豁免被自家 R3_SELF_HARM 守卫整体跳过，「我不想自杀」裸词「自杀」直配误弹完整卡。
    // 安全不变量：①只降级为 gentle（共情+热线资源行仍可见），绝不静默零响应；
    // ②词在句首（前窗为空，如「我不想活了」）不豁免——真危机词行为零变化；
    // ③多词命中时任一未被否定仍走完整卡（宁严勿漏）；④词表本体零增删。
    const NEGATION_MARKS = /不想|没想|没有想|不会|不曾|从未|不用|并不|并未|再也不|不再|哪天要是|要是哪天|假如|如果|万一|假设/;
    const nonNegatedDirect = allDirectMatches.filter((word) => {
      const idx = lowerText.indexOf(word.toLowerCase());
      if (idx <= 0) return true; // 词首无前窗或异常，保守保留完整卡
      const win = lowerText.slice(Math.max(0, idx - 6), idx);
      // 两种否定形态：①窗口内含否定/假设词；②窗口以「不/没/别/未/无」单字结尾（覆盖
      // 「我不想自杀」→ 词表词「想自杀」前窗只有「我不」的情形）
      return !(NEGATION_MARKS.test(win) || /[不没别未无]$/.test(win));
    });
    if (nonNegatedDirect.length > 0) {
      return { isCrisis: true, level: "direct", matchedWords: nonNegatedDirect };
    }
    return { isCrisis: true, level: "gentle", matchedWords: ["negation_gentle"] };
  }
  
  // P1.7 F7：长文场景提高阈值，单纯情绪低落表达不单独触发危机模板
  // 长文（>500字）时，间接危机词须叠加明确危机信号词才命中
  const isLongText = text.length > 500;
  if (isLongText && allIndirectMatches.length > 0) {
    // 长文场景：检查是否有明确的危机信号词（自伤/自杀计划/正在实施）
    const explicitCrisisSignals = /自杀|自残|自伤|割腕|跳楼|跳河|吃安眠药|上吊|烧炭|想死|不想活|结束生命|了结自己/i;
    if (!explicitCrisisSignals.test(text)) {
      // 长文且无明确危机信号，不触发危机模板
      return { isCrisis: false, level: "none", matchedWords: [] };
    }
  }
  
  if (allIndirectMatches.length >= 1) {
    return { isCrisis: true, level: "indirect", matchedWords: allIndirectMatches };
  }
  return { isCrisis: false, level: "none", matchedWords: [] };
}

// ========== 1.9.2: 危机热线区块代码层模板（强制注入，禁止模型自由撰写） ==========

// H1：唯一热线卡片常量（全站所有危机触发点统一调用）
