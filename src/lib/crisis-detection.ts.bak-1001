// 该占位不产生可见文案，仅保留拼接结构；危机热线已由 CRISIS_HOTLINE_CARD 完整给出。
const CRISIS_WECHAT_GUIDANCE = ``;

// 1.9.2: 危机热线模板常量（逐字拼接，号码与"24小时"不经过模型生成）
// H1：使用唯一热线卡片常量
export const CRISIS_HOTLINE_TEMPLATE = `小酷听到你说这些，非常担心你的安全。

请你现在立刻拨打心理援助热线：
${CRISIS_HOTLINE_CARD_WITH_EMERGENCY}还有一件事想说：作为跨性别者或性少数，你的身份处境、家里和身边人的反应，都可能让这份沉重更重——这不是你的错。现在你的身体状态怎么样？有没有哪里不舒服需要先处理？`;

// [P06-P07-FIX 20260915] P06 温和资源卡：过去史+当下稳定场景（感谢信任+资源+不阻断对话，禁用高危话术）
export const PAST_HISTORY_GENTLE_RESPONSE = `谢谢你愿意告诉我这段经历，把它说出来是需要勇气的事。

那段最难的时候已经过去了，现在的你还在好好生活，这本身就很了不起。

我还是想把一些支持资源放在这里，不需要马上用，留着就好：
${CRISIS_HOTLINE_CARD}

小酷在这里陪着你。你想从哪儿聊起都可以，随便聊聊也行。`;

// [P06-P07-FIX 20260915] 危机卡复述句包装：文案开头复述用户消息片段（三件套 R6 机检），模板本体零改动
export function crisisCardWithParaphrase(card: string, userText: string): string {
  const frag = String(userText || "")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, 16);
  if (!frag) return card;
  return `你刚说到『${frag}』，我在这里听你说。\n\n` + card;
}

